{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv: Create Virtual Environment",
            "type": "shell",
            "command": "uv",
            "args": ["venv", "--allow-existing"],
            "problemMatcher": []
        },
        {
            "label": "uv: Install Dependencies",
            "type": "shell",
            "command": "uv",
            "args": ["pip", "sync", "--require-hashes", "requirements-dev.txt"],
            "dependsOn": "uv: Create Virtual Environment",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "uv: Compile Runtime Requirements",
            "type": "shell",
            "command": "uv",
            "args": ["pip", "compile", "pyproject.toml", "--universal", "--python", ".venv", "--python-version", "3.10", "--generate-hashes", "--no-header", "--output-file", "requirements.txt"],
            "dependsOn": "uv: Create Virtual Environment",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "uv: Compile Dependency Locks",
            "type": "shell",
            "command": "uv",
            "args": ["pip", "compile", "pyproject.toml", "--extra", "dev", "--universal", "--python", ".venv", "--python-version", "3.10", "--generate-hashes", "--no-header", "--constraint", "requirements.txt", "--output-file", "requirements-dev.txt"],
            "dependsOn": "uv: Compile Runtime Requirements",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "uv",
            "args": ["run", "pytest"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Format Code (Ruff)",
            "type": "shell",
            "command": "uv",
            "args": ["run", "ruff", "format", "."],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Lint Code (Ruff)",
            "type": "shell",
            "command": "uv",
            "args": ["run", "ruff", "check", "."],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                {
                    "owner": "ruff",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.+):(\\d+):(\\d+): (\\w+) (.+)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        },
        {
            "label": "Fix Code (Ruff)",
            "type": "shell",
            "command": "uv",
            "args": ["run", "ruff", "check", "--fix", "."],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
